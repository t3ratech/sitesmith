{
  "openapi": "3.1.0",
  "info": {
    "title": "T3rnel Sitesmith Service & Multi-Tenant Router API",
    "version": "1.4.0",
    "description": "Public service discovery, client portal, and multi-tenant preview/live site router for T3rnel Sitesmith by Teratech Solutions (Private) Limited.",
    "contact": {
      "name": "Teratech Solutions (Private) Limited",
      "url": "https://sitesmith.t3ratech.co.zw",
      "email": "admin@t3ratech.co.zw"
    }
  },
  "servers": [
    {
      "url": "https://sitesmith.t3ratech.co.zw",
      "description": "Public Sitesmith website and AI discovery files"
    },
    {
      "url": "https://t3rnel-sitesmith-admin.t3ratech.workers.dev",
      "description": "Client Self-Managed Portal and Multi-Tenant Site Router"
    }
  ],
  "paths": {
    "/ai/summary.json": {
      "get": {
        "operationId": "getSitesmithSummary",
        "summary": "Return structured summary of T3rnel Sitesmith tiers, pricing, and guarantees",
        "responses": {
          "200": {
            "description": "Structured JSON summary"
          }
        }
      }
    },
    "/ai/faq.json": {
      "get": {
        "operationId": "getSitesmithFaq",
        "summary": "Return structured FAQ answers for business owners evaluating T3rnel Sitesmith",
        "responses": {
          "200": {
            "description": "Structured JSON FAQ list"
          }
        }
      }
    },
    "/p/{slug}/": {
      "get": {
        "operationId": "getClientPreviewSite",
        "summary": "Serve a client's private noindex preview website from the Single Multi-Tenant Router Worker",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered HTML preview site"
          }
        }
      }
    },
    "/live/{slug}/": {
      "get": {
        "operationId": "getClientLiveSite",
        "summary": "Serve a client's production website from the Single Multi-Tenant Router Worker",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered HTML live site"
          }
        }
      }
    },
    "/api/request-preview": {
      "post": {
        "operationId": "requestSitesmithPreview",
        "summary": "Ask for a free preview website for a business. The preview is built automatically and emailed to the address given.",
        "description": "Submit only for the business owner, or with their permission, using an address they own. Limits: 1 request per email address per day, 3 per IP address per hour. Send `Accept: application/json` to receive JSON.",
        "servers": [
          {
            "url": "https://t3rnel-sitesmith-admin.t3ratech.workers.dev"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request stored; the preview is built and emailed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid email or website, or suspicious content.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Request came from a browser page on another website.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached for this email address or IP address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "PreviewRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Where the preview is sent; the business owner's address."
          },
          "business_name": {
            "type": "string",
            "maxLength": 200
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 500,
            "description": "The business's current website; the preview is built from it."
          },
          "social_pages": {
            "type": "string",
            "maxLength": 2000,
            "description": "Facebook, Instagram, Google Maps and similar links, one per line."
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the business does and wants said."
          },
          "additional": {
            "type": "string",
            "maxLength": 1000
          },
          "service_type": {
            "type": "string",
            "description": "Optional, e.g. \"upgrade\" or \"new\"."
          }
        }
      }
    }
  }
}
